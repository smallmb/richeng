# 已解析到云服务器公网 IP 的域名。
API_DOMAIN=api.example.com
# 托管网页应用的 HTTPS 域名；若只使用安装包，仍应填写未来网页地址。
APP_DOMAIN=app.example.com

# OpenAI 兼容模型服务，不要加 /chat/completions。
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=

# SMTP 服务商提供的凭据。
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=日程 <no-reply@example.com>
