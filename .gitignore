/android/app/release

# Widget Preview related
.widget_preview/
# 本地服务数据、密钥配置与交付压缩包不提交到版本库。
server/*.sqlite3*
server/*.log
server/.env
server/config.local.json
server/__pycache__/
deliverables/
# 忽略本地服务进程号。
server/*.pid
deploy/.env
deploy/runtime/
